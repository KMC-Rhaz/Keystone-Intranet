@model IReadOnlyList<Keystone.Intranet.Web.Areas.Admin.ViewModels.ActivityItemViewModel>

@if (Model.Count == 0)
{
  <p class="ks-muted">No activity yet.</p>
}
else
{
  foreach (var item in Model)
  {
    <div class="ks-kv">
      <div class="ks-kv-label">@item.At</div>
      <div class="ks-kv-value">
        <strong>@item.ReferenceNo</strong> (@item.DefinitionName) - @item.Action by @item.ActorName
        @if (!string.IsNullOrEmpty(item.Comment))
        {
          <div class="ks-muted">@item.Comment</div>
        }
      </div>
    </div>
  }
}
